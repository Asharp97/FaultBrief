# Copy to .env locally. Never commit the populated file.
FAULTBRIEF_ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
DEMO_SERVICE_URL=http://127.0.0.1:8001

# Optional at this scaffold stage. Use your Neon connection string later.
# PostgreSQL credentials must never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=

# Optional until live model calls are implemented. Keep this key on the backend.
MODEL_PROVIDER=
MODEL_NAME=
AI_PROVIDER_API_KEY=
