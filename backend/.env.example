# Copy to backend/.env. Never commit populated configuration.
DB_URL=
AUTH_URL=
JWKS_URL=

# Optional direct/unpooled PostgreSQL URL for migrations; otherwise DB_URL is used.
MIGRATION_DATABASE_URL=

# Managed Neon Auth uses the AUTH_URL origin as issuer.
# Override only when the configured provider's token contract requires it.
AUTH_ISSUER=
AUTH_AUDIENCE=

# Read-only Ledger diagnostic connector; set using scripts/configure-diagnostics.mjs.
DIAGNOSTIC_DEMO_TOKEN=
DIAGNOSTIC_DEMO_URL=http://127.0.0.1:8001


# Optional bounded model-selected investigation mode; baseline needs no model key.
INVESTIGATION_MODE=baseline
INVESTIGATION_MAX_STEPS=5
INVESTIGATION_MAX_SECONDS=45
MODEL_MAX_CALLS=6
MODEL_BUDGET_USD=0.02
# Configure current provider prices before enabling model_selected mode.
# MODEL_INPUT_USD_PER_MILLION=replace-with-current-input-price
# MODEL_OUTPUT_USD_PER_MILLION=replace-with-current-output-price
# MODEL_PROVIDER=openai
# MODEL_NAME=replace-with-a-tool-calling-and-structured-output-model
# AI_PROVIDER_API_KEY=replace-with-private-provider-key
