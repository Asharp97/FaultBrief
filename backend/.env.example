# Copy to backend/.env. Never commit populated configuration.
DB_URL=
AUTH_URL=
JWKS_URL=

# Optional direct/unpooled PostgreSQL URL for migrations; otherwise DB_URL is used.
MIGRATION_DATABASE_URL=

# Managed Neon Auth uses the AUTH_URL origin as issuer.
# Override only when the configured provider's token contract requires it.
AUTH_ISSUER=
AUTH_AUDIENCE=
