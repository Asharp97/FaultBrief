{
  "name": "faultbrief",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/dev.mjs --smoke",
    "format": "pnpm --dir frontend exec prettier .. --ignore-path ../.prettierignore --ignore-path ../.gitignore --write",
    "format:check": "pnpm --dir frontend exec prettier .. --ignore-path ../.prettierignore --ignore-path ../.gitignore --check",
    "frontend:build": "pnpm --dir frontend build",
    "frontend:typecheck": "pnpm --dir frontend typecheck",
    "db:migrate": "node scripts/migrate.mjs upgrade",
    "db:check": "node scripts/migrate.mjs check",
    "db:sql": "node scripts/migrate.mjs sql",
    "api:export": "node scripts/export-contracts.mjs",
    "auth:configure": "node scripts/configure-auth.mjs",
    "frontend:e2e": "pnpm --dir frontend test:e2e"
  }
}
