meta {
  name: 03 Viewer can read report
  type: http
  seq: 3
}

get {
  url: {{base_url}}/v1/workspaces/{{fixture_workspace_id}}/investigations/{{fixture_investigation_id}}/report
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_viewer}}
}

script:pre-request {
  if (String(bru.getEnvVar("run_viewer_tests")) !== "true") {
    bru.runner.skipRequest();
  } else {
    ["fixture_workspace_id","fixture_investigation_id","token_viewer"].forEach(function (name) {
      const value = (bru.getVar(name) || bru.getEnvVar(name));
      if (!value || String(value).includes("replace-with-") || String(value).includes("{{")) {
        throw new Error("Missing " + name + ". Select Local, fill tokens, and run earlier numbered requests first (see README).");
      }
    });
    
  }
  
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response contract and captured IDs", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.id).to.equal(bru.getEnvVar("fixture_report_id"));
  });
}

docs {
  Viewer can read report.
  
  Prerequisites: viewer provisioned, fixture helper run with viewer user ID, fixture IDs set.
  Expected: HTTP 200.
  Skipped unless run_viewer_tests=true. See README for setup.
}

