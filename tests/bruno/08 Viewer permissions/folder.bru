meta {
  name: 08 Viewer permissions
  seq: 8
}

docs {
  Optional: provision viewer in 02 Identity, run the fixture helper with that user ID, and enable run_viewer_tests.
}

script:pre-request {
  if (String(bru.getEnvVar("run_viewer_tests")) === "true") {
    ["fixture_workspace_id","fixture_customer_id","fixture_investigation_id","fixture_report_id","fixture_evidence_id","fixture_owner_user_id","fixture_viewer_user_id"].forEach(function (name) {
      if (!(bru.getVar(name) || bru.getEnvVar(name))) throw new Error("Set " + name + " from seed_fixture.py before running this optional folder.");
    });
  }
}

