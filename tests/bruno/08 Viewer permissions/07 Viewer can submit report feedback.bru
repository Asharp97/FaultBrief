meta {
  name: 07 Viewer can submit report feedback
  type: http
  seq: 7
}

post {
  url: {{base_url}}/v1/workspaces/{{fixture_workspace_id}}/investigations/{{fixture_investigation_id}}/reports/{{fixture_report_id}}/feedback
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_viewer}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "rating": "incomplete",
    "comment": "Synthetic viewer feedback."
  }
}

script:pre-request {
  if (String(bru.getEnvVar("run_viewer_tests")) !== "true") {
    bru.runner.skipRequest();
  } else {
    ["fixture_workspace_id","fixture_investigation_id","fixture_report_id","token_viewer"].forEach(function (name) {
      const value = (bru.getVar(name) || bru.getEnvVar(name));
      if (!value || String(value).includes("replace-with-") || String(value).includes("{{")) {
        throw new Error("Missing " + name + ". Select Local, fill tokens, and run earlier numbered requests first (see README).");
      }
    });
    
  }
  
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("Response contract and captured IDs", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.user_id).to.equal(bru.getEnvVar("fixture_viewer_user_id"));
    expect(body.report_id).to.equal(bru.getEnvVar("fixture_report_id"));
    expect(body.rating).to.equal("incomplete");
  });
}

docs {
  Viewer can submit report feedback.
  
  Prerequisites: viewer provisioned, fixture helper run with viewer user ID, fixture IDs set.
  Expected: HTTP 201.
  Skipped unless run_viewer_tests=true. See README for setup.
}

