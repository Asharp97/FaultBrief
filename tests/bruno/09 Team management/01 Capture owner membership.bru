meta {
  name: 01 Capture owner membership
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v1/workspaces/{{workspace_a_id}}/memberships
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

script:pre-request {
  ["token_a","workspace_a_id","workspace_b_id","user_a_id","user_b_id"].forEach(function (name) {
    const value = bru.getVar(name) || bru.getEnvVar(name);
    if (!value || String(value).includes("replace-with-") || String(value).includes("{{")) throw new Error("Missing " + name + ". Run folders 01–06 and earlier team requests first.");
  });
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Response and access contract", function () {
    const item = res.getBody().items.find((m) => m.user_id === bru.getVar("user_a_id"));
    expect(item.role).to.equal("owner");
    bru.setVar("team_owner_membership_id", item.id);
  });
}

docs {
  Capture owner membership. Use only the synthetic A/B workspaces created in folders 03–04. This sequence changes user B's access to A, then revokes it again.
  Expected HTTP 200. Run sequentially; use development test accounts only.
}
