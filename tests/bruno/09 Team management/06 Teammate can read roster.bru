meta {
  name: 06 Teammate can read roster
  type: http
  seq: 6
}

get {
  url: {{base_url}}/v1/workspaces/{{workspace_a_id}}/memberships
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_b}}
}

script:pre-request {
  ["token_b","workspace_a_id","workspace_b_id","user_a_id","user_b_id","team_owner_membership_id","team_membership_id"].forEach(function (name) {
    const value = bru.getVar(name) || bru.getEnvVar(name);
    if (!value || String(value).includes("replace-with-") || String(value).includes("{{")) throw new Error("Missing " + name + ". Run folders 01–06 and earlier team requests first.");
  });
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
}

docs {
  Teammate can read roster. Use only the synthetic A/B workspaces created in folders 03–04. This sequence changes user B's access to A, then revokes it again.
  Expected HTTP 200. Run sequentially; use development test accounts only.
}
