meta {
  name: 04 Duplicate customer in same company
  type: http
  seq: 4
}

post {
  url: {{base_url}}/v1/workspaces/{{workspace_a_id}}/customers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Duplicate synthetic customer",
    "external_id": "bruno-customer-{{run_id}}"
  }
}

script:pre-request {
  ["workspace_a_id","run_id","token_a"].forEach(function (name) {
    const value = (bru.getVar(name) || bru.getEnvVar(name));
    if (!value || String(value).includes("replace-with-") || String(value).includes("{{")) {
      throw new Error("Missing " + name + ". Select Local, fill tokens, and run earlier numbered requests first (see README).");
    }
  });
}

tests {
  test("HTTP 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
  test("Response contract and captured IDs", function () {
    expect(res.getStatus()).to.equal(409);
    const body = res.getBody();
    expect(body).to.have.all.keys("detail");
    expect(body.detail).to.be.a("string").that.is.not.empty;
    
    expect(body.detail).to.equal("Resource or relationship conflict.");
  });
}

docs {
  Duplicate customer in same company.
  
  Prerequisites: run earlier numbered folders and requests in order.
  Expected: HTTP 409 — Resource or relationship conflict..
}

