meta {
  name: 09 Queue investigation A
  type: http
  seq: 9
}

post {
  url: {{base_url}}/v1/workspaces/{{workspace_a_id}}/investigations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customer_id": "{{customer_a_id}}",
    "question": "Why can Jamie not download an export for this account?"
  }
}

script:pre-request {
  ["workspace_a_id","customer_a_id","token_a"].forEach(function (name) {
    const value = (bru.getVar(name) || bru.getEnvVar(name));
    if (!value || String(value).includes("replace-with-") || String(value).includes("{{")) {
      throw new Error("Missing " + name + ". Select Local, fill tokens, and run earlier numbered requests first (see README).");
    }
  });
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("Response contract and captured IDs", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    bru.setVar("investigation_a_id", body.id);
    expect(body.workspace_id).to.equal(bru.getVar("workspace_a_id"));
    expect(body.customer_id).to.equal(bru.getVar("customer_a_id"));
    expect(body.created_by_user_id).to.equal(bru.getVar("user_a_id"));
    expect(body.state).to.equal("queued");
    expect(body.started_at).to.equal(null);
    expect(body.finished_at).to.equal(null);
  });
}

docs {
  Queue investigation A.
  
  Prerequisites: run earlier numbered folders and requests in order.
  Expected: HTTP 201.
}

