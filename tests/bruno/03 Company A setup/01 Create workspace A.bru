meta {
  name: 01 Create workspace A
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/workspaces
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Bruno manual A - {{run_id}}"
  }
}

script:pre-request {
  ["run_id","token_a"].forEach(function (name) {
    const value = (bru.getVar(name) || bru.getEnvVar(name));
    if (!value || String(value).includes("replace-with-") || String(value).includes("{{")) {
      throw new Error("Missing " + name + ". Select Local, fill tokens, and run earlier numbered requests first (see README).");
    }
  });
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("Response contract and captured IDs", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    bru.setVar("workspace_a_id", body.id);
    expect(body.name).to.equal("Bruno manual A - " + bru.getVar("run_id"));
  });
}

docs {
  Create workspace A.
  
  Prerequisites: run earlier numbered folders and requests in order.
  Expected: HTTP 201.
}

