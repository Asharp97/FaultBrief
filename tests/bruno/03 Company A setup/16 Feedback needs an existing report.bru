meta {
  name: 16 Feedback needs an existing report
  type: http
  seq: 16
}

post {
  url: {{base_url}}/v1/workspaces/{{workspace_a_id}}/investigations/{{investigation_a_id}}/reports/00000000-0000-4000-8000-000000000000/feedback
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "rating": "helpful",
    "comment": "Synthetic manual test"
  }
}

script:pre-request {
  ["workspace_a_id","investigation_a_id","token_a"].forEach(function (name) {
    const value = (bru.getVar(name) || bru.getEnvVar(name));
    if (!value || String(value).includes("replace-with-") || String(value).includes("{{")) {
      throw new Error("Missing " + name + ". Select Local, fill tokens, and run earlier numbered requests first (see README).");
    }
  });
}

tests {
  test("HTTP 404", function () {
    expect(res.getStatus()).to.equal(404);
  });
  test("Response contract and captured IDs", function () {
    expect(res.getStatus()).to.equal(404);
    const body = res.getBody();
    expect(body).to.have.all.keys("detail");
    expect(body.detail).to.be.a("string").that.is.not.empty;
    
    expect(body.detail).to.equal("Report not found.");
  });
}

docs {
  Feedback needs an existing report.
  
  Prerequisites: run earlier numbered folders and requests in order.
  Expected: HTTP 404 — Report not found..
}

