meta {
  name: 03 Queue investigation B
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/workspaces/{{workspace_b_id}}/investigations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_b}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customer_id": "{{customer_b_id}}",
    "question": "Why is the separate company export unavailable?"
  }
}

script:pre-request {
  ["workspace_b_id","customer_b_id","token_b"].forEach(function (name) {
    const value = (bru.getVar(name) || bru.getEnvVar(name));
    if (!value || String(value).includes("replace-with-") || String(value).includes("{{")) {
      throw new Error("Missing " + name + ". Select Local, fill tokens, and run earlier numbered requests first (see README).");
    }
  });
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("Response contract and captured IDs", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    bru.setVar("investigation_b_id", body.id);
    expect(body.created_by_user_id).to.equal(bru.getVar("user_b_id"));
    expect(body.workspace_id).to.equal(bru.getVar("workspace_b_id"));
    expect(body.state).to.equal("queued");
    expect(body.started_at).to.equal(null);
    expect(body.finished_at).to.equal(null);
  });
}

docs {
  Queue investigation B.
  
  Prerequisites: run earlier numbered folders and requests in order.
  Expected: HTTP 201.
}

