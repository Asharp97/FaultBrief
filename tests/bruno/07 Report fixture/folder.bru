meta {
  name: 07 Report fixture
  seq: 7
}

docs {
  Optional: run the guarded fixture helper, fill fixture IDs, and enable run_report_fixture. These are synthetic records, not agent results.
}

script:pre-request {
  if (String(bru.getEnvVar("run_report_fixture")) === "true") {
    ["fixture_workspace_id","fixture_customer_id","fixture_investigation_id","fixture_report_id","fixture_evidence_id","fixture_owner_user_id"].forEach(function (name) {
      if (!(bru.getVar(name) || bru.getEnvVar(name))) throw new Error("Set " + name + " from seed_fixture.py before running this optional folder.");
    });
  }
}

