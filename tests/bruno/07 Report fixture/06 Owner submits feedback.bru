meta {
  name: 06 Owner submits feedback
  type: http
  seq: 6
}

post {
  url: {{base_url}}/v1/workspaces/{{fixture_workspace_id}}/investigations/{{fixture_investigation_id}}/reports/{{fixture_report_id}}/feedback
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "rating": "helpful",
    "comment": "Synthetic manual test: citation is visible."
  }
}

script:pre-request {
  if (String(bru.getEnvVar("run_report_fixture")) !== "true") {
    bru.runner.skipRequest();
  } else {
    ["fixture_workspace_id","fixture_investigation_id","fixture_report_id","token_a"].forEach(function (name) {
      const value = (bru.getVar(name) || bru.getEnvVar(name));
      if (!value || String(value).includes("replace-with-") || String(value).includes("{{")) {
        throw new Error("Missing " + name + ". Select Local, fill tokens, and run earlier numbered requests first (see README).");
      }
    });
    
  }
  
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("Response contract and captured IDs", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.workspace_id).to.equal(bru.getEnvVar("fixture_workspace_id"));
    expect(body.investigation_id).to.equal(bru.getEnvVar("fixture_investigation_id"));
    expect(body.report_id).to.equal(bru.getEnvVar("fixture_report_id"));
    expect(body.user_id).to.equal(bru.getEnvVar("fixture_owner_user_id"));
    expect(body.rating).to.equal("helpful");
  });
}

docs {
  Owner submits feedback.
  
  Prerequisites: run the fixture helper and set all fixture_* variables in Local.
  Expected: HTTP 201.
  Skipped unless run_report_fixture=true. See README for setup.
}

