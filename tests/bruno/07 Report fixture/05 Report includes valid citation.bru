meta {
  name: 05 Report includes valid citation
  type: http
  seq: 5
}

get {
  url: {{base_url}}/v1/workspaces/{{fixture_workspace_id}}/investigations/{{fixture_investigation_id}}/report
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

script:pre-request {
  if (String(bru.getEnvVar("run_report_fixture")) !== "true") {
    bru.runner.skipRequest();
  } else {
    ["fixture_workspace_id","fixture_investigation_id","token_a"].forEach(function (name) {
      const value = (bru.getVar(name) || bru.getEnvVar(name));
      if (!value || String(value).includes("replace-with-") || String(value).includes("{{")) {
        throw new Error("Missing " + name + ". Select Local, fill tokens, and run earlier numbered requests first (see README).");
      }
    });
    
  }
  
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response contract and captured IDs", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.id).to.equal(bru.getEnvVar("fixture_report_id"));
    expect(body.workspace_id).to.equal(bru.getEnvVar("fixture_workspace_id"));
    expect(body.investigation_id).to.equal(bru.getEnvVar("fixture_investigation_id"));
    expect(body.confidence).to.be.within(0,1);
    expect(body.root_cause).to.include("Synthetic fixture");
    expect(body.citations).to.have.length(1);
    expect(body.citations[0].evidence_id).to.equal(bru.getEnvVar("fixture_evidence_id"));
    expect(body.limitations).to.include("Synthetic manual-test fixture; no live diagnostics ran.");
  });
}

docs {
  Report includes valid citation.
  
  Prerequisites: run the fixture helper and set all fixture_* variables in Local.
  Expected: HTTP 200.
  Skipped unless run_report_fixture=true. See README for setup.
}

