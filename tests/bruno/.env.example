# Copy to .env in this collection directory. Never commit real JWTs.
# Values are signed JWTs from two DIFFERENT test users in your configured Neon Auth.
# Do not paste DB_URL, AUTH_URL, JWKS_URL, an API key, or an opaque session token here.
FAULTBRIEF_BRUNO_TOKEN_A=replace-with-user-a-jwt
FAULTBRIEF_BRUNO_TOKEN_B=replace-with-user-b-jwt
# Optional third test user, used only with run_viewer_tests=true.
FAULTBRIEF_BRUNO_TOKEN_VIEWER=
