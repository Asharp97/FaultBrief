meta {
  name: 05 Malformed bearer token
  type: http
  seq: 5
}

get {
  url: {{base_url}}/v1/me
  body: none
  auth: bearer
}

auth:bearer {
  token: not-a-jwt
}

script:pre-request {
  ["base_url"].forEach(function (name) {
    const value = (bru.getVar(name) || bru.getEnvVar(name));
    if (!value || String(value).includes("replace-with-") || String(value).includes("{{")) {
      throw new Error("Missing " + name + ". Select Local, fill tokens, and run earlier numbered requests first (see README).");
    }
  });
}

tests {
  test("HTTP 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
  test("Response contract and captured IDs", function () {
    expect(res.getStatus()).to.equal(401);
    const body = res.getBody();
    expect(body).to.have.all.keys("detail");
    expect(body.detail).to.be.a("string").that.is.not.empty;
    
  });
}

docs {
  Malformed bearer token.
  
  Prerequisites: services running; Local selected; test JWTs configured for authenticated requests.
  Expected: HTTP 401.
}

