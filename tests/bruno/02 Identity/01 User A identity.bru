meta {
  name: 01 User A identity
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v1/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_a}}
}

script:pre-request {
  ["token_a"].forEach(function (name) {
    const value = (bru.getVar(name) || bru.getEnvVar(name));
    if (!value || String(value).includes("replace-with-") || String(value).includes("{{")) {
      throw new Error("Missing " + name + ". Select Local, fill tokens, and run earlier numbered requests first (see README).");
    }
  });
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response contract and captured IDs", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    bru.setVar("user_a_id", body.id);
    expect(body).to.have.all.keys("id","created_at","updated_at");
  });
}

docs {
  User A identity.
  
  Prerequisites: services running; Local selected; test JWTs configured for authenticated requests.
  Expected: HTTP 200.
  Captures user_a_id. This provisions the local application user, not a Neon account.
}

