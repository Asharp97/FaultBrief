meta {
  name: 19 Job matches model reservations
  type: http
  seq: 19
}

get {
  url: {{base_url}}/v1/workspaces/{{workspace_id}}/investigations/{{investigation_id}}/jobs
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(200); });
  test("Scoped model execution contract", function () { const audit = bru.getVar("model_audit"); const job = res.getBody().items[0];
    expect(job.model_call_count).to.equal(audit.length);
    const total = audit.reduce(function (sum, item) { return sum + Number(item.reserved_cost_usd); }, 0);
    expect(Number(job.reserved_model_cost_usd)).to.be.closeTo(total, 0.000001); });
}

docs {
  Run after requests 01–17. The audit contains safe metadata and estimated reservations, not provider-measured billing. Request 20 uses the optional outsider token and run_isolation flag.
}
