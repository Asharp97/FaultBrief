meta {
  name: 09 Read-only diagnostic audit
  type: http
  seq: 9
}

get {
  url: {{base_url}}/v1/workspaces/{{workspace_id}}/investigations/{{investigation_id}}/tool-calls?limit=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {

  if (!bru.getVar("investigation_id")) throw new Error("Run 05 first to capture an investigation ID.");
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Workflow contract", function () {
    res.getBody().items.forEach((item) => { expect(item.read_only).to.equal(true); expect(item).not.to.have.property("arguments_redacted"); });
  });
}

docs {
  Read-only diagnostic audit. Run requests in order against a development workspace with an approved customer and active worker.
  Expected HTTP 200. After 05, repeat 06 until completed or inconclusive before 07–15.
}
