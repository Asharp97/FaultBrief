meta {
  name: 06 Check investigation state
  type: http
  seq: 6
}

get {
  url: {{base_url}}/v1/workspaces/{{workspace_id}}/investigations/{{investigation_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {

  if (!bru.getVar("investigation_id")) throw new Error("Run 05 first to capture an investigation ID.");
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Workflow contract", function () {
    expect(["queued","running","completed","inconclusive","failed"]).to.include(res.getBody().state); bru.setVar("investigation_state", res.getBody().state);
  });
}

docs {
  Check investigation state. Run requests in order against a development workspace with an approved customer and active worker.
  Expected HTTP 200. After 05, repeat 06 until completed or inconclusive before 07–15.
}
