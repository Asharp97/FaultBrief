get {
  url: {{base_url}}/v1/workspaces/{{workspace_id}}/memberships
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Workflow contract", function () {
    expect(res.getBody().items.length).to.be.greaterThan(0);
  });
}

docs {
  Workspace membership. Run requests in order against a development workspace with an approved customer and active worker.
  Expected HTTP 200. After 05, repeat 06 until completed or inconclusive before 07–15.
}
