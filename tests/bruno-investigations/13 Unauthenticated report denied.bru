meta {
  name: 13 Unauthenticated report denied
  type: http
  seq: 13
}

get {
  url: {{base_url}}/v1/workspaces/{{workspace_id}}/investigations/{{investigation_id}}/report
  body: none
  auth: none
}

script:pre-request {

  if (!bru.getVar("investigation_id")) throw new Error("Run 05 first to capture an investigation ID.");
}

tests {
  test("HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
}

docs {
  Unauthenticated report denied. Run requests in order against a development workspace with an approved customer and active worker.
  Expected HTTP 401. After 05, repeat 06 until completed or inconclusive before 07–15.
}
