# Copy to ignored .env. Use your development workspace and signed Neon JWT.
INVESTIGATION_TOKEN=replace-with-your-jwt
INVESTIGATION_WORKSPACE_ID=replace-with-workspace-uuid
INVESTIGATION_CUSTOMER_ID=replace-with-connected-faultbrief-customer-uuid
# Optional distinct user's token; that account must have no membership in this workspace.
INVESTIGATION_OUTSIDER_TOKEN=
