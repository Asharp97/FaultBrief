meta {
  name: 17 Conflicting replay rejected
  type: http
  seq: 17
}

post {
  url: {{base_url}}/v1/workspaces/{{workspace_id}}/investigations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "submission_id": "{{submission_id}}",
    "customer_id": "{{customer_id}}",
    "question": "This is a different issue using the same submission ID."
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(409); });
  test("Replay contract", function () { expect(res.getBody().detail).to.include("different ticket"); });
}

docs {
  Run after requests 01–15 using the captured submission UUID. A replay must return the original case; a changed payload must fail without creating new work.
}
