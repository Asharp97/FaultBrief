meta {
  name: 04 Connected affected customer
  type: http
  seq: 4
}

get {
  url: {{base_url}}/v1/workspaces/{{workspace_id}}/customers/{{customer_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Workflow contract", function () {
    expect(res.getBody().workspace_id).to.equal(bru.getEnvVar("workspace_id"));
  });
}

docs {
  Connected affected customer. Run requests in order against a development workspace with an approved customer and active worker.
  Expected HTTP 200. After 05, repeat 06 until completed or inconclusive before 07–15.
}
