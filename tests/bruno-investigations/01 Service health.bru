meta {
  name: 01 Service health
  type: http
  seq: 1
}

get {
  url: {{base_url}}/health
  body: none
  auth: none
}

script:pre-request {
  // Test-only UUID; production clients use a cryptographic UUID generator.
  bru.setVar("submission_id", "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) { const r = Math.floor(Math.random() * 16); return (c === "x" ? r : (r & 3) | 8).toString(16); }));
  bru.setVar("investigation_id", ""); bru.setVar("report_id", ""); bru.setVar("evidence_ids", []);
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
}

docs {
  Service health. Run requests in order against a development workspace with an approved customer and active worker.
  Expected HTTP 200. After 05, repeat 06 until completed or inconclusive before 07–15.
}
