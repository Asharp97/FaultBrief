meta {
  name: 07 Read structured report
  type: http
  seq: 7
}

get {
  url: {{base_url}}/v1/workspaces/{{workspace_id}}/investigations/{{investigation_id}}/report
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  if (!["completed","inconclusive"].includes(bru.getVar("investigation_state"))) throw new Error("Run 06 again until completed or inconclusive before reading a report.");
  if (!bru.getVar("investigation_id")) throw new Error("Run 05 first to capture an investigation ID.");
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Workflow contract", function () {
    const body = res.getBody(); expect(body.observed_facts).to.be.an("array"); expect(body.next_steps).to.be.an("array"); expect(body.confidence).to.be.within(0,1); expect(["rules","model","rules_fallback"]).to.include(body.explanation_source); bru.setVar("report_id", body.id);
  });
}

docs {
  Read structured report. Run requests in order against a development workspace with an approved customer and active worker.
  Expected HTTP 200. After 05, repeat 06 until completed or inconclusive before 07–15.
}
