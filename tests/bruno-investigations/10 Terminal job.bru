meta {
  name: 10 Terminal job
  type: http
  seq: 10
}

get {
  url: {{base_url}}/v1/workspaces/{{workspace_id}}/investigations/{{investigation_id}}/jobs
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {

  if (!bru.getVar("investigation_id")) throw new Error("Run 05 first to capture an investigation ID.");
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Workflow contract", function () {
    const job = res.getBody().items[0]; expect(job.state).to.equal("completed"); expect(job.attempts).to.be.greaterThan(0);
  });
}

docs {
  Terminal job. Run requests in order against a development workspace with an approved customer and active worker.
  Expected HTTP 200. After 05, repeat 06 until completed or inconclusive before 07–15.
}
