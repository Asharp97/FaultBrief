# Copy to .env. These are YOUR DEVELOPMENT test accounts; never commit actual credentials.
AUTH_TEST_EMAIL=replace-with-your-test-email
AUTH_TEST_PASSWORD=replace-with-your-test-password
AUTH_TEST_NAME=Test Engineer

# Optional recovery tests change this disposable account's password.
AUTH_RESET_TOKEN=replace-with-token-from-your-recovery-email
AUTH_TEST_NEW_PASSWORD=replace-with-a-different-test-password
