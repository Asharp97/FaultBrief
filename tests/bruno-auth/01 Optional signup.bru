meta {
  name: 01 Optional signup
  type: http
  seq: 1
}

post {
  url: {{frontend_url}}/api/auth/sign-up/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{frontend_url}}
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "name": "{{name}}"
  }
}

script:pre-request {
  if (String(bru.getEnvVar("run_signup")) !== "true") bru.runner.skipRequest();
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  
}

docs {
  Run in sequence with Bruno cookies enabled. Expected HTTP 200.
  Uses the frontend (Next.js), not FastAPI port 8000. See README for setup.
}

