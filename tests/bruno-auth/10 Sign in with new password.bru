meta {
  name: 10 Sign in with new password
  type: http
  seq: 10
}

post {
  url: {{frontend_url}}/api/auth/sign-in/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{frontend_url}}
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{new_password}}"
  }
}

script:pre-request {
  if (String(bru.getEnvVar("run_password_recovery")) !== "true") bru.runner.skipRequest();
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Response and access contract", function () {
    expect(res.getBody().user.email).to.equal(bru.getEnvVar("email"));
  });
}

docs {
  Confirms recovery changed the login password.
  Expected HTTP 200. Run sequentially; use development test accounts only.
}
