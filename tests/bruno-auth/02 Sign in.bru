meta {
  name: 02 Sign in
  type: http
  seq: 2
}

post {
  url: {{frontend_url}}/api/auth/sign-in/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{frontend_url}}
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("User authenticated", function () { expect(res.getBody().user.email).to.equal(bru.getEnvVar("email")); });
}

docs {
  Run in sequence with Bruno cookies enabled. Expected HTTP 200.
  Uses the frontend (Next.js), not FastAPI port 8000. See README for setup.
}

