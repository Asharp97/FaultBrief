meta {
  name: 13 Old password rejected
  type: http
  seq: 13
}

post {
  url: {{frontend_url}}/api/auth/sign-in/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{frontend_url}}
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  if (String(bru.getEnvVar("run_password_recovery")) !== "true") bru.runner.skipRequest();
}

tests {
  test("HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
}

docs {
  Run after changing to a different password; confirms the previous password fails.
  Expected HTTP 401. Run sequentially; use development test accounts only.
}
