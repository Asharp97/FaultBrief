vars {
  frontend_url: http://localhost:3000
  email: {{process.env.AUTH_TEST_EMAIL}}
  password: {{process.env.AUTH_TEST_PASSWORD}}
  name: {{process.env.AUTH_TEST_NAME}}
  run_signup: false
  run_password_recovery: false
  reset_token: {{process.env.AUTH_RESET_TOKEN}}
  new_password: {{process.env.AUTH_TEST_NEW_PASSWORD}}
}
