  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{frontend_url}}
}

body:json {
  {}
}

script:pre-request {
  if (String(bru.getEnvVar("run_password_recovery")) !== "true") bru.runner.skipRequest();
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
}

docs {
  Clears the newly created cookie session.
  Expected HTTP 200. Run sequentially; use development test accounts only.
}
