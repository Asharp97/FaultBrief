meta {
  name: 13 Create actual application export
  type: http
  seq: 13
}

post {
  url: {{demo_url}}/v1/customers/{{customer_id}}/exports
  body: json
  auth: bearer
}

auth:bearer {
  token: {{app_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "member_id": "{{member_id}}",
    "report_id": "{{report_id}}"
  }
}

tests {
  test("HTTP 202", function () { expect(res.getStatus()).to.equal(202); });
  test("Expected behavior", function () {
    const body=res.getBody();
    expect(body.state).to.equal("queued");
  });
}

docs {
  Run earlier requests first with Local selected. Expected HTTP 202.
  This collection operates on synthetic Ledger data, never Neon workspace data.
  Scenario creation/reset requires the operator key; diagnostic reads use the read-only key.
}

